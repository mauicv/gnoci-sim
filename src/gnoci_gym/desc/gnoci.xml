<mujoco model="gnoci">
    <option timestep="0.005" gravity="0 0 -9.8"/>
    <compiler angle="radian" meshdir="meshes" eulerseq="zyx" autolimits="true" inertiafromgeom="true"/>

    <default>
        <joint
            limited="true"
            damping="0.01"
            armature="0.01"
            frictionloss="0.01"
        />
        <position 
            kp="2.5"
            dampratio="0.5"
            forcelimited="true"
            forcerange="-1 1"
        />
        <motor 
            ctrlrange="-1 1"
            gear="1"
        />
        <default class="visualgeom">
            <geom 
                material="visualgeom"
                condim="1"
                contype="0"
                conaffinity="0"
            />
        </default>

        <default class="body">
            <geom
                material="body"
                condim="1"
                friction=".7"
                solimp=".9 .99 .003"
                solref=".015 1"
            />
        </default>
    </default>

    <asset>
        <mesh name="body-main" content_type="model/stl" file="body-main-quad.stl" scale="0.001 0.001 0.001"/>
        <mesh name="hip-left" content_type="model/stl" file="hip-left.stl" scale="0.001 0.001 0.001"/>
        <mesh name="hip-right" content_type="model/stl" file="hip-right.stl" scale="0.001 0.001 0.001"/>
        <mesh name="thigh-left" content_type="model/stl" file="thigh-left.stl" scale="0.001 0.001 0.001"/>
        <mesh name="thigh-right" content_type="model/stl" file="thigh-right.stl" scale="0.001 0.001 0.001"/>
        <mesh name="lower-leg-left" content_type="model/stl" file="lower-leg-left.stl" scale="0.001 0.001 0.001"/>
        <mesh name="lower-leg-right" content_type="model/stl" file="lower-leg-right.stl" scale="0.001 0.001 0.001"/>
        <texture builtin="checker" height="100" name="texplane" rgb1="0 0 0" rgb2="0.8 0.8 0.8" type="2d" width="100"/>
        <material name="MatPlane" reflectance="0.5" shininess="1" specular="1" texrepeat="60 60" texture="texplane"/>
        <material
            name="visualgeom"
            rgba="1 1 1 1"
        />
        <material
            name="body"
            rgba="0.5 0.9 0.2 0.0"
        />
    </asset>

    <worldbody>
        <light
            directional="true"
            diffuse="0.4 0.4 0.4"
            specular="0.1 0.1 0.1"
            pos="0 0 15.0"
            dir="0 0 -1"
            castshadow="false"
        />
        <geom condim="3" friction="1 .1 .1" material="MatPlane" name="floor" pos="0 0 0" rgba="0.8 0.9 0.8 1" size="10 10 0.0125" type="plane"/>
        <camera
            name="track"
            mode="trackcom"
            pos="-0.25 -0.25 0.375"
            xyaxes="0.7071 -0.7071 0 0.4082 0.4082 0.8165"
        />
        <body name="root" pos="0 0 0.157" quat="1 0 0 0">
            <freejoint name="root" />
            <site name="imu" size="0.01" pos="0 0 0" />
            <geom name="root" class="visualgeom" type="mesh" mesh="body-main" pos="0 0 0" quat="1 0 0 0"/>
            <geom class="body" type="box" size="0.115 0.05 0.015" pos="0 0 0.015" density="400"/>
            <geom class="body" type="box" size="0.05 0.05 0.017" pos="0 0 -0.023" density="400"/>

            <body name="hip-front-left" pos="-0.0895 -0.025 -0.03" quat="1 0 0 0">
                <geom class="visualgeom" type="mesh" mesh="hip-left" pos="0 0 0" quat="1 0 0 0"/>
                <geom class="body" type="cylinder" size="0.022 0.032" pos="0 -0.026 0" quat="1 1 0 0" density="400"/>
                <joint name="hip-front-left-joint" pos="0 -0.01 0" axis="1 0 0" range="-0.38 0.42"/>

                <body name="thigh-front-left" pos="0.007 -0.03 0.005" quat="1 0 -0.38 0">
                    <geom class="visualgeom" type="mesh" mesh="thigh-left" pos="0 0 0" quat="1 0 0 0"/>
                    <geom class="body" type="cylinder" size="0.007 0.003" pos="0 0 0.005" density="400"/>
                    <joint name="thigh-front-left-joint" pos="0 0 0" axis="0 -1 0" range="-0.65 1"/>

                    <body name="lower-leg-front-left" pos="0 -0.012 -0.062" quat="1 0 0.75 0">
                        <geom class="visualgeom" type="mesh" mesh="lower-leg-left" pos="0 0 0" quat="1 0 0 0"/>
                        <geom class="body" type="capsule" size="0.01" fromto="0 0 0 0.005 -0.005 -0.085" pos="0 0 0" quat="1 0 0 0" density="400"/>
                        <joint name="lower-leg-front-left-joint" pos="0 0 0" axis="0 -1 0" range="-1.15 0.3"/>
                        <site name="foot-front-left" size="0.0102" pos="0.005 -0.005 -0.085" />
                    </body>
                </body>
            </body>

            <body name="hip-front-right" pos="-0.0895 0.025 -0.03" quat="1 0 0 0">
                <geom class="visualgeom" type="mesh" mesh="hip-right" pos="0 0 0" quat="1 0 0 0"/>
                <geom class="body" type="cylinder" size="0.022 0.032" pos="0 0.026 0" quat="1 1 0 0" density="400"/>
                <joint name="hip-front-right-joint" pos="0 0.01 0" axis="1 0 0" range="-0.42 0.38"/>

                <body name="thigh-front-right" pos="0.007 0.03 0.005" quat="1 0 -0.38 0">
                    <geom class="visualgeom" type="mesh" mesh="thigh-right" pos="0 0 0" quat="1 0 0 0"/>
                    <geom class="body" type="cylinder" size="0.007 0.003" pos="0 0 0.005" density="400"/>
                    <joint name="thigh-front-right-joint" pos="0 0 0" axis="0 1 0" range="-1 0.65"/>

                    <body name="lower-leg-front-right" pos="0 0.012 -0.062" quat="1 0 0.75 0">
                        <geom class="visualgeom" type="mesh" mesh="lower-leg-right" pos="0 0 0" quat="1 0 0 0"/>
                        <geom class="body" type="capsule" size="0.01" fromto="0 0 0 0.005 0.005 -0.085" pos="0 0 0" quat="1 0 0 0" density="400"/>
                        <joint name="lower-leg-front-right-joint" pos="0 0 0" axis="0 1 0" range="-0.3 1.15"/>
                        <site name="foot-front-right" size="0.0102" pos="0.005 0.005 -0.085" />
                    </body>
                </body>
            </body>

            <body name="hip-back-left" pos="0.0895 -0.025 -0.03" quat="1 0 0 0">
                <geom class="visualgeom" type="mesh" mesh="hip-left" pos="0 0 0" quat="1 0 0 0"/>
                <geom class="body" type="cylinder" size="0.022 0.032" pos="0 -0.026 0" quat="1 1 0 0" density="400"/>
                <joint name="hip-back-left-joint" pos="0 -0.01 0" axis="1 0 0" range="-0.38 0.42"/>

                <body name="thigh-back-left" pos="0.007 -0.03 0.005" quat="1 0 -0.38 0">
                    <geom class="visualgeom" type="mesh" mesh="thigh-left" pos="0 0 0" quat="1 0 0 0"/>
                    <geom class="body" type="cylinder" size="0.007 0.003" pos="0 0 0.005" density="400"/>
                    <joint name="thigh-back-left-joint" pos="0 0 0" axis="0 -1 0" range="-0.65 1"/>

                    <body name="lower-leg-back-left" pos="0 -0.012 -0.062" quat="1 0 0.75 0">
                        <geom class="visualgeom" type="mesh" mesh="lower-leg-left" pos="0 0 0" quat="1 0 0 0"/>
                        <geom class="body" type="capsule" size="0.01" fromto="0 0 0 0.005 -0.005 -0.085" pos="0 0 0" quat="1 0 0 0" density="400"/> 
                        <joint name="lower-leg-back-left-joint" pos="0 0 0" axis="0 -1 0" range="-1.15 0.3"/>
                        <site name="foot-back-left" size="0.0102" pos="0.005 -0.005 -0.085" />
                    </body>
                </body>
            </body>

            <body name="hip-back-right" pos="0.0895 0.025 -0.03" quat="1 0 0 0">
                <geom class="visualgeom" type="mesh" mesh="hip-right" pos="0 0 0" quat="1 0 0 0"/>
                <geom class="body" type="cylinder" size="0.022 0.032" pos="0 0.026 0" quat="1 1 0 0" density="400"/>
                <joint name="hip-back-right-joint" pos="0 0.01 0" axis="1 0 0" range="-0.42 0.38"/>

                <body name="thigh-back-right" pos="0.007 0.03 0.005" quat="1 0 -0.38 0">
                    <geom class="visualgeom" type="mesh" mesh="thigh-right" pos="0 0 0" quat="1 0 0 0"/>
                    <geom class="body" type="cylinder" size="0.007 0.003" pos="0 0 0.005" density="400"/>
                    <joint name="thigh-back-right-joint" pos="0 0 0" axis="0 1 0" range="-1 0.65"/>

                    <body name="lower-leg-back-right" pos="0 0.012 -0.062" quat="1 0 0.75 0">
                        <geom class="visualgeom" type="mesh" mesh="lower-leg-right" pos="0 0 0" quat="1 0 0 0"/>
                        <geom class="body" type="capsule" size="0.01" fromto="0 0 0 0.005 0.005 -0.085" pos="0 0 0" quat="1 0 0 0" density="400"/>
                        <joint name="lower-leg-back-right-joint" pos="0 0 0" axis="0 1 0" range="-0.3 1.15"/>
                        <site name="foot-back-right" size="0.0102" pos="0.005 0.005 -0.085" />
                    </body>
                </body>
            </body>
        </body>

        
    </worldbody>

    <actuator>
        <motor name="servo-hip-front-left" joint="hip-front-left-joint"/>
        <motor name="servo-hip-front-right" joint="hip-front-right-joint"/>
        <motor name="servo-hip-back-left" joint="hip-back-left-joint"/>
        <motor name="servo-hip-back-right" joint="hip-back-right-joint"/>
        <motor name="servo-thigh-front-left" joint="thigh-front-left-joint"/>
        <motor name="servo-thigh-front-right" joint="thigh-front-right-joint"/>
        <motor name="servo-thigh-back-left" joint="thigh-back-left-joint"/>
        <motor name="servo-thigh-back-right" joint="thigh-back-right-joint"/>
        <motor name="servo-lower-leg-front-left" joint="lower-leg-front-left-joint"/>
        <motor name="servo-lower-leg-front-right" joint="lower-leg-front-right-joint"/>
        <motor name="servo-lower-leg-back-left" joint="lower-leg-back-left-joint"/>
        <motor name="servo-lower-leg-back-right" joint="lower-leg-back-right-joint"/>
    </actuator>

    <sensor>
        <actuatorpos name="hip-front-left-servo-pos" actuator="servo-hip-front-left" />
        <actuatorvel name="hip-front-left-servo-vel" actuator="servo-hip-front-left" />
        <actuatorpos name="hip-front-right-servo-pos" actuator="servo-hip-front-right" />
        <actuatorvel name="hip-front-right-servo-vel" actuator="servo-hip-front-right" />
        <actuatorpos name="hip-back-left-servo-pos" actuator="servo-hip-back-left" />
        <actuatorvel name="hip-back-left-servo-vel" actuator="servo-hip-back-left" />
        <actuatorpos name="hip-back-right-servo-pos" actuator="servo-hip-back-right" />
        <actuatorvel name="hip-back-right-servo-vel" actuator="servo-hip-back-right" />
        <actuatorpos name="thigh-front-left-servo-pos" actuator="servo-thigh-front-left" />
        <actuatorvel name="thigh-front-left-servo-vel" actuator="servo-thigh-front-left" />
        <actuatorpos name="thigh-front-right-servo-pos" actuator="servo-thigh-front-right" />
        <actuatorvel name="thigh-front-right-servo-vel" actuator="servo-thigh-front-right" />
        <actuatorpos name="thigh-back-left-servo-pos" actuator="servo-thigh-back-left" />
        <actuatorvel name="thigh-back-left-servo-vel" actuator="servo-thigh-back-left" />
        <actuatorpos name="thigh-back-right-servo-pos" actuator="servo-thigh-back-right" />
        <actuatorvel name="thigh-back-right-servo-vel" actuator="servo-thigh-back-right" />
        <actuatorpos name="lower-leg-front-left-servo-pos" actuator="servo-lower-leg-front-left" />
        <actuatorvel name="lower-leg-front-left-servo-vel" actuator="servo-lower-leg-front-left" />
        <actuatorpos name="lower-leg-front-right-servo-pos" actuator="servo-lower-leg-front-right" />
        <actuatorvel name="lower-leg-front-right-servo-vel" actuator="servo-lower-leg-front-right" />
        <actuatorpos name="lower-leg-back-left-servo-pos" actuator="servo-lower-leg-back-left" />
        <actuatorvel name="lower-leg-back-left-servo-vel" actuator="servo-lower-leg-back-left" />
        <actuatorpos name="lower-leg-back-right-servo-pos" actuator="servo-lower-leg-back-right" />
        <actuatorvel name="lower-leg-back-right-servo-vel" actuator="servo-lower-leg-back-right" />

        <gyro name="gyro" site="imu" noise="0.005" cutoff="34.9" />
        <accelerometer name="accel" site="imu" noise="0.01" cutoff="40"/>

        <touch name="front-left-foot-contact" site="foot-front-left"/>
        <touch name="front-right-foot-contact" site="foot-front-right"/>
        <touch name="back-left-foot-contact" site="foot-back-left"/>
        <touch name="back-right-foot-contact" site="foot-back-right"/>

    </sensor>
</mujoco>